{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>mailerlite/renovate-config:base"
    ],
    "enabledManagers": [
        "custom.regex",
        "dockerfile",
        "docker-compose",
        "helmv3",
        "github-actions"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/Dockerfile(\\.[\\w-]+)?$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( extractVersion=(?<extractVersion>.+?))?( versioning=(?<versioning>.*?))?( currentDigest=(?<currentDigest>sha256:[a-f0-9]+))?\n.*?_VERSION=[\"]?(?<currentValue>.*[^\"\\n])"
            ],
            "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
        },
        {
            "customType": "regex",
            "description": "Internal mailerlitehub images with a literal tag, e.g. FROM .../base-images/go:v1.0.34-1.26 or ARG BASE_IMAGE=.../base-images/base:v1.0.42",
            "managerFilePatterns": ["/Dockerfile(\\.[\\w-]+)?$/"],
            "matchStrings": [
                "(?:FROM\\s+(?:--\\S+\\s+)*|COPY\\s+--from=|ARG\\s+\\w+=)[\"']?(?<depName>[a-z0-9.-]+\\.pkg\\.dev/mailerlitehub/[a-z0-9._/-]+)(?::(?<currentValue>[\\w.-]+))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?\\s"
            ],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Internal mailerlitehub images whose tag ends in a build arg, e.g. FROM .../base-images/php-apps:v1.1.4-${PHP_VERSION} - only the version before the variable is tracked and updated",
            "managerFilePatterns": ["/Dockerfile(\\.[\\w-]+)?$/"],
            "matchStrings": [
                "(?:FROM\\s+(?:--\\S+\\s+)*|COPY\\s+--from=|ARG\\s+\\w+=)[\"']?(?<depName>[a-z0-9.-]+\\.pkg\\.dev/mailerlitehub/[a-z0-9._/-]+):(?<currentValue>v?[0-9]+(?:\\.[0-9]+)*)-\\$\\{?\\w+\\}?"
            ],
            "datasourceTemplate": "docker",
            "extractVersionTemplate": "^(?<version>v?[0-9]+(?:\\.[0-9]+)*)-"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/helm(chart)?/values\\.(dev|prod|staging|production)\\.ya?ml$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)?\n.*?image: .*?:(?<currentValue>[^\\n@]*)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
            ],
            "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
        }
    ],
    "packageRules": [
        {
            "description": "Disable dockerfile manager for internal images - handled by custom regex manager",
            "matchManagers": ["dockerfile"],
            "matchPackagePatterns": ["mailerlitehub"],
            "enabled": false
        },
        {
            "description": "Docker images - separate PRs per package",
            "matchDatasources": ["docker"],
            "addLabels": ["docker"],
            "reviewers": ["team:sre"]
        },
        {
            "description": "GitHub Actions - separate PRs per package",
            "matchDatasources": ["github-actions"],
            "addLabels": ["github"],
            "reviewers": ["team:sre"]
        },
        {
            "description": "Elasticsearch - disable major updates",
            "matchPackagePatterns": ["elasticsearch"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "description": "Helm charts - separate PRs per package",
            "matchDatasources": ["helm"],
            "addLabels": ["helm"],
            "reviewers": ["team:sre"]
        },
        {
            "description": "GitHub releases - separate PRs per package",
            "matchDatasources": ["github-releases"],
            "reviewers": ["team:sre"]
        }
    ]
}
