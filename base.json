                "mailerlite/cloudflare-exporter",
                "mailerlite/cluster-upgrade-notifications-function",
                "mailerlite/cors-proxy",
                "mailerlite/countdown",
                "mailerlite/domain-exporter",
                "mailerlite/email-receiver",
                "mailerlite/entri-provider-exporter",
                "mailerlite/file-vulnerability-scanner",
                "mailerlite/filestore-backup",
                "mailerlite/fonts-proxy",
                "mailerlite/geoip",
                "mailerlite/github-releases-exporter",
                "mailerlite/greenarrow",
                "mailerlite/hawk",
                "mailerlite/httpstatus",
                "mailerlite/imap-client",
                "mailerlite/intercom-kb-sync",
                "mailerlite/json-exporter-python",
                "mailerlite/landings-exporter",
                "mailerlite/laravel-exporter",
                "mailerlite/linear-actions",
                "mailerlite/mailerlite-domains",
                "mailerlite/mailerlite-landings",
                "mailerlite/mailerlite-mcp",
                "mailerlite/mailerlite-parsers",
                "mailerlite/mailerlite-pdf",
                "mailerlite/mailerlite-placeholder",
                "mailerlite/mailerlite-reports-forward-consumer",
                "mailerlite/mailerlite-reports-link-consumer",
                "mailerlite/mailerlite-reports-queues-worker",
                "mailerlite/mailerlite-unsubscribe-consumer",
                "mailerlite/mailerlite-updater",
                "mailerlite/mailertest",
                "mailerlite/ml-models",
                "mailerlite/mta-report-handler",
                "mailerlite/mypiper",
                "mailerlite/nebula-back",
                "mailerlite/nebula-front",
                "mailerlite/nebula-html-agent",
                "mailerlite/oncall-monitor",
                "mailerlite/pairingbot",
                "mailerlite/recruitee-mcp-server",
                "mailerlite/redis-queue-exporter",
                "mailerlite/robusta",
                "mailerlite/screenshoter",
                "mailerlite/sentry-bug-bot",
                "mailerlite/sherlock",
                "mailerlite/slow-query-reporter",
                "mailerlite/sms-gateway",
                "mailerlite/smtp-redis-data-exporter",
                "mailerlite/spamtraps-sync",
                "mailerlite/streamlit-dashboard",
                "mailerlite/string-slinger",
                "mailerlite/swiss-army-knife",
                "mailerlite/tracking-ingress",
                "mailerlite/video-converter",
                "mailerlite/webrisk-api",
                "mailerlite/whois-exporter",
                "mailerlite/xarf-parse",
                "mailersend/mailmon",
                "mailersend/smtp-blackhole",
                "mailersend/smtp-inbound",
                "mailersend/smtp-proxy"
            ],
            "schedule": ["* * * * 1-5"],
            "automergeSchedule": ["* * * * 1-5"],
            "automerge": true
        },
        {
            "description": "Internal GHA patch/minor - auto-merge on weekdays, only in the repos listed (containers and micros, not the main apps)",
            "matchManagers": ["github-actions"],
            "matchPackagePatterns": ["^(mailerlite|mailersend|mailercheck)/"],
            "matchUpdateTypes": ["patch", "minor"],
            "addLabels": ["automerge"],
            "matchRepositories": [
                "mailercheck/checker",
                "mailercheck/open-smtp",
                "mailerlite/alertmanager-linear-receiver",
                "mailerlite/amiokay-landings",
                "mailerlite/assistant-agent",
                "mailerlite/autossl-caddy",
                "mailerlite/base-docker-images",
                "mailerlite/bf-exporter",
                "mailerlite/branch-operator",
                "mailerlite/butter-robot",
                "mailerlite/caddy-waf-exporter",
                "mailerlite/cloudflare-exporter",
                "mailerlite/cluster-upgrade-notifications-function",
                "mailerlite/cors-proxy",
                "mailerlite/countdown",
                "mailerlite/domain-exporter",
                "mailerlite/email-receiver",
                "mailerlite/entri-provider-exporter",
                "mailerlite/file-vulnerability-scanner",
                "mailerlite/filestore-backup",
                "mailerlite/fonts-proxy",
                "mailerlite/geoip",
                "mailerlite/github-releases-exporter",
                "mailerlite/greenarrow",
                "mailerlite/hawk",
                "mailerlite/httpstatus",
                "mailerlite/imap-client",
                "mailerlite/intercom-kb-sync",
                "mailerlite/json-exporter-python",
                "mailerlite/landings-exporter",
                "mailerlite/laravel-exporter",
                "mailerlite/linear-actions",
                "mailerlite/mailerlite-domains",
                "mailerlite/mailerlite-landings",
                "mailerlite/mailerlite-mcp",
                "mailerlite/mailerlite-parsers",
                "mailerlite/mailerlite-pdf",
                "mailerlite/mailerlite-placeholder",
                "mailerlite/mailerlite-reports-forward-consumer",
                "mailerlite/mailerlite-reports-link-consumer",
                "mailerlite/mailerlite-reports-queues-worker",
                "mailerlite/mailerlite-unsubscribe-consumer",
                "mailerlite/mailerlite-updater",
                "mailerlite/mailertest",
                "mailerlite/ml-models",
                "mailerlite/mta-report-handler",
                "mailerlite/mypiper",
                "mailerlite/nebula-back",
                "mailerlite/nebula-front",
                "mailerlite/nebula-html-agent",
                "mailerlite/oncall-monitor",
                "mailerlite/pairingbot",
                "mailerlite/recruitee-mcp-server",
                "mailerlite/redis-queue-exporter",
                "mailerlite/robusta",
                "mailerlite/screenshoter",
                "mailerlite/sentry-bug-bot",
                "mailerlite/sherlock",
                "mailerlite/slow-query-reporter",
                "mailerlite/sms-gateway",
                "mailerlite/smtp-redis-data-exporter",
                "mailerlite/spamtraps-sync",
                "mailerlite/streamlit-dashboard",
                "mailerlite/string-slinger",
                "mailerlite/swiss-army-knife",
                "mailerlite/tracking-ingress",
                "mailerlite/video-converter",
                "mailerlite/webrisk-api",
                "mailerlite/whois-exporter",
                "mailerlite/xarf-parse",
                "mailersend/mailmon",
                "mailersend/smtp-blackhole",
                "mailersend/smtp-inbound",
                "mailersend/smtp-proxy"
            ],
            "schedule": ["* * * * 1-5"],
            "automergeSchedule": ["* * * * 1-5"],
            "automerge": true
        },
        {
            "description": "Group digest-only pins into a single PR - no version changes",
            "matchManagers": ["dockerfile", "docker-compose"],
            "matchUpdateTypes": ["pinDigest"],
            "groupName": "Docker digest pins"
        },
        {
            "description": "images.yaml version slots - patch updates only, never promote to a new minor/major",
            "matchFileNames": ["**/images.yaml"],
            "matchUpdateTypes": ["major", "minor"],
            "enabled": false
        },
        {
            "description": "images.yaml - one PR per package across all its tracked version slots",
            "matchFileNames": ["**/images.yaml"],
            "groupName": "{{depName}}"
        }
    ],
    "enabledManagers": [
        "custom.regex",
        "dockerfile",
        "docker-compose",
        "github-actions"
    ],
    "dockerfile": {
        "managerFilePatterns": [
            "/^Makefile$/",
            "/Dockerfile(\\.[\\w-]+)?$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)images\\.yaml$/"],
            "matchStringsStrategy": "recursive",
            "matchStrings": [
                "versions:\\s+#\\s+renovate:\\s+datasource=(?<datasource>[^\\s\\n]+)\\s+depName=(?<depName>[^\\s\\n]+)(?:\\s+extractVersion=(?<extractVersion>[^\\s\\n]+))?(?:\\s+versioning=(?<versioning>[^\\s\\n]+))?\\n(?:[ \\t]+-[^\\n]+\\n?)+",
                "-\\s+\"(?<currentValue>[^\"]+)\""
            ],
            "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
        }
    ]
}
